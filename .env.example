# ─── Database (AWS RDS PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/cravebite"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-random-secret-here"   # generate: openssl rand -base64 32
NEXTAUTH_URL="https://your-amplify-app.amplifyapp.com"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_xxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxx"
